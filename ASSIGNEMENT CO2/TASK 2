#include <stdio.h>
#define N 4
int main(void) {
    const char *name[N] = {"P1", "P2", "P3", "P4"};
    int arrival[N] = {0, 1, 2, 3};
    int burst[N] = {8, 4, 9, 5};
    int quantum = 3;
    int left[N], finish[N], first[N];
    int queue[256], head = 0, tail = 0;
    int added[N] = {0};
    for (int i = 0; i < N; i++) {
        left[i] = burst[i];
        first[i] = -1;
    }
    int time = 0, done = 0;
    queue[tail++] = 0;
    added[0] = 1;
    printf("Gantt:");
    while (done < N) {
        if (head == tail) {
            for (int i = 0; i < N; i++) {
                if (!added[i] && arrival[i] <= time) {
                    queue[tail++] = i;
                    added[i] = 1;
                }
            }
            if (head == tail) {
                time++;
                continue;
            }
        }
        int p = queue[head++];
        if (first[p] == -1)
            first[p] = time;
        int run = quantum < left[p] ? quantum : left[p];
        printf(" %s(%d-%d)", name[p], time, time + run);
        time += run;
        left[p] -= run;
        for (int i = 0; i < N; i++) {
            if (!added[i] && arrival[i] <= time) {
                queue[tail++] = i;
                added[i] = 1;
            }
        }
        if (left[p] > 0) {
            queue[tail++] = p;
        } else {
            finish[p] = time;
            done++;
        }
    }
    double tw = 0, tt = 0, tr = 0;
    printf("\nProcess CT TAT WT RT\n");
    for (int i = 0; i < N; i++) {
        int tat = finish[i] - arrival[i];
        int wt = tat - burst[i];
        int rt = first[i] - arrival[i];
        tt += tat;
        tw += wt;
        tr += rt;
         printf("%-7s %2d %3d %2d %2d\n",
               name[i], finish[i], tat, wt, rt);
    }
    printf("Average TAT = %.2f\n", tt/N);
    printf("Average WT = %.2f\n", tw/N);
    printf("Average RT = %.2f\n", tr/N);

    return 0;
}
