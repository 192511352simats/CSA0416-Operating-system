#include <stdio.h>
#include <pthread.h>
#define CAMERAS 8
void *process_camera(void *arg) {
    int id = *(int *)arg;
    printf("Camera %d is processing frames\n", id);
    return NULL;

int main(void) {
    pthread_t threads[CAMERAS];
    int ids[CAMERAS];
    for (int i = 0; i < CAMERAS; i++) {
        ids[i] = i + 1;
        pthread_create(&threads[i], NULL,
                       process_camera, &ids[i]);
    }
    for (int i = 0; i < CAMERAS; i++) {
        pthread_join(threads[i], NULL);
    }
    printf("All camera frames processed successfully\n");
    return 0;
}
