
#include <stdio.h>
#include <string.h>

int main()
{
    char files[10][30];
    char name[30];
    int n, i, choice, found;

    printf("Enter number of files: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("Enter file name: ");
        scanf("%s", files[i]);
    }

    do
    {
        printf("\n1. Create File");
        printf("\n2. Delete File");
        printf("\n3. Search File");
        printf("\n4. Display Files");
        printf("\n5. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter file name: ");
                scanf("%s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                        found = 1;
                }

                if(found)
                    printf("File already exists");
                else if(n < 10)
                {
                    strcpy(files[n], name);
                    n++;
                    printf("File created successfully");
                }
                else
                    printf("Directory is full");
                break;

            case 2:
                printf("Enter file name: ");
                scanf("%s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        for(int j = i; j < n - 1; j++)
                            strcpy(files[j], files[j + 1]);

                        n--;
                        printf("File deleted successfully");
                        break;
                    }
                }

                if(!found)
                    printf("File not found");
                break;

            case 3:
                printf("Enter file name: ");
                scanf("%s", name);

                found = 0;
                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        found = 1;
                        printf("File found");
                        break;
                    }
                }

                if(!found)
                    printf("File not found");
                break;

            case 4:
                printf("\nFiles in directory:\n");
                for(i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 5:
                printf("Exiting");
                break;

            default:
                printf("Invalid choice");
        }

    } while(choice != 5);

    return 0;
}
