
#include <stdio.h>
struct employee
{
    int id;
    char name[30];
    float salary;
};
int main()
{
    FILE *fp;
    struct employee e;
    int choice, n;
    fp = fopen("employee.dat", "rb+");
    if(fp == NULL)
        fp = fopen("employee.dat", "wb+");
    do
    {
        printf("\n1. Add Employee");
        printf("\n2. Display Employee");
        printf("\n3. Update Salary");
        printf("\n4. Exit");
        printf("\nEnter your choice: ");
        scanf("%d", &choice);
        switch(choice)
        {
            case 1:
                printf("Enter employee ID: ");
                scanf("%d", &e.id);
                printf("Enter employee name: ");
                scanf("%s", e.name);
                printf("Enter salary: ");
                scanf("%f", &e.salary);
                fseek(fp, (e.id - 1) * sizeof(e), SEEK_SET);
                fwrite(&e, sizeof(e), 1, fp);
                printf("Employee added successfully");
                break;
            case 2:
                printf("Enter employee ID: ");
                scanf("%d", &n);
                fseek(fp, (n - 1) * sizeof(e), SEEK_SET);
                if(fread(&e, sizeof(e), 1, fp) == 1)
                {
                    printf("\nEmployee ID: %d", e.id);
                    printf("\nName: %s", e.name);
                    printf("\nSalary: %.2f", e.salary);
                }
                else
                    printf("Employee not found");
                break;
            case 3:
                printf("Enter employee ID: ");
                scanf("%d", &n);
                fseek(fp, (n - 1) * sizeof(e), SEEK_SET);
                if(fread(&e, sizeof(e), 1, fp) == 1)
                {
                    printf("Enter new salary: ");
                    scanf("%f", &e.salary);
                    fseek(fp, (n - 1) * sizeof(e), SEEK_SET);
                    fwrite(&e, sizeof(e), 1, fp);
                    printf("Salary updated successfully");
                }
                else
                    printf("Employee not found");
                break;
            case 4:
                printf("Exiting");
                break;
            default:
                printf("Invalid choice");
        }
    } while(choice != 4);
    fclose(fp);
    return 0;
}
