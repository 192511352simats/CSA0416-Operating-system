#include <stdio.h>
int main()
{
    FILE *f1, *f2;
    char file1[100], file2[100], c;
    printf("Enter the filename to open for reading \n");
    scanf("%s", file1);
    f1 = fopen(file1, "r");
    printf("Enter the filename to open for writing \n");
    scanf("%s", file2);
    f2 = fopen(file2, "w");
    while ((c = fgetc(f1)) != EOF)
        fputc(c, f2);
    printf("\nContents copied to %s", file2);
    fclose(f1);
    fclose(f2);

    return 0;
}
