
#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>

int main()
{
    int fd, flags;
    char data[] = "UNIX I/O System Calls";
    struct stat st;
    DIR *dir;
    struct dirent *entry;

    // Open or create a file
    fd = open("sample.txt", O_CREAT | O_RDWR | O_TRUNC, 0644);

    if(fd < 0)
    {
        perror("open");
        return 1;
    }

    write(fd, data, sizeof(data) - 1);

    // fcntl system call
    flags = fcntl(fd, F_GETFL);
    printf("File flags: %d\n", flags);

    // lseek system call
    lseek(fd, 0, SEEK_SET);
    printf("File pointer moved to beginning.\n");

    // stat system call
    if(stat("sample.txt", &st) == 0)
    {
        printf("File size: %ld bytes\n", (long)st.st_size);
        printf("File permissions: %o\n", st.st_mode & 0777);
    }

    close(fd);

    // opendir system call
    dir = opendir(".");

    if(dir == NULL)
    {
        perror("opendir");
        return 1;
    }

    // readdir system call
    printf("\nDirectory contents:\n");

    while((entry = readdir(dir)) != NULL)
    {
        printf("%s\n", entry->d_name);
    }

    closedir(dir);

    return 0;
}
