
#include <stdio.h>

int main()
{
    int pages[50], frames[10], time[10];
    int n, f, i, j;
    int pageFaults = 0, pageHits = 0;
    int counter = 0, found, pos;

    printf("Enter the number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
        time[i] = 0;
    }

    printf("\nPage\tFrames\t\tStatus\n");

    for (i = 0; i < n; i++)
    {
        found = 0;
        counter++;

        // Check whether page is already present
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                time[j] = counter;
                pageHits++;
                break;
            }
        }

        if (found == 0)
        {
            // Find an empty frame
            pos = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            // If no empty frame, replace least recently used page
            if (pos == -1)
            {
                pos = 0;

                for (j = 1; j < f; j++)
                {
                    if (time[j] < time[pos])
                    {
                        pos = j;
                    }
                }
            }

            frames[pos] = pages[i];
            time[pos] = counter;
            pageFaults++;
        }

        printf("%d\t", pages[i]);

        for (j = 0; j < f; j++)
        {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        if (found == 0)
            printf("\tPage Fault");
        else
            printf("\tHit");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits = %d\n", pageHits);

    return 0;
}
