
#include <stdio.h>

int main()
{
    int pages[50], frames[10];
    int n, f, i, j, k;
    int pageFaults = 0, pageHits = 0;
    int found, pos, farthest, future;

    printf("Enter the number of pages: ");
    scanf("%d", &n);

    printf("Enter the page reference string:\n");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &pages[i]);
    }

    printf("Enter the number of frames: ");
    scanf("%d", &f);

    for (i = 0; i < f; i++)
    {
        frames[i] = -1;
    }

    printf("\nPage\tFrames\t\tStatus\n");

    for (i = 0; i < n; i++)
    {
        found = 0;

        // Check whether page is already present
        for (j = 0; j < f; j++)
        {
            if (frames[j] == pages[i])
            {
                found = 1;
                pageHits++;
                break;
            }
        }

        if (found == 0)
        {
            // Find an empty frame
            pos = -1;

            for (j = 0; j < f; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }
            }

            // If no empty frame, find the page used farthest in future
            if (pos == -1)
            {
                farthest = -1;
                pos = 0;

                for (j = 0; j < f; j++)
                {
                    future = -1;

                    for (k = i + 1; k < n; k++)
                    {
                        if (frames[j] == pages[k])
                        {
                            future = k;
                            break;
                        }
                    }

                    // Replace a page that is never used again
                    if (future == -1)
                    {
                        pos = j;
                        break;
                    }

                    if (future > farthest)
                    {
                        farthest = future;
                        pos = j;
                    }
                }
            }

            frames[pos] = pages[i];
            pageFaults++;
        }

        printf("%d\t", pages[i]);

        for (j = 0; j < f; j++)
        {
            if (frames[j] == -1)
                printf("- ");
            else
                printf("%d ", frames[j]);
        }

        if (found == 0)
            printf("\tPage Fault");
        else
            printf("\tHit");

        printf("\n");
    }

    printf("\nTotal Page Faults = %d\n", pageFaults);
    printf("Total Page Hits = %d\n", pageHits);

    return 0;
}
