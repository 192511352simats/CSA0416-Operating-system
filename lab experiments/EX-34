
#include <stdio.h>

int main()
{
    int n, i;
    char record[50][100];

    printf("Enter number of records: ");
    scanf("%d", &n);

    printf("Enter the records:\n");

    for(i = 0; i < n; i++)
    {
        printf("Record %d: ", i + 1);
        scanf(" %99[^\n]", record[i]);
    }

    printf("\nRecords stored sequentially:\n");

    for(i = 0; i < n; i++)
    {
        printf("Record %d: %s\n", i + 1, record[i]);
    }

    printf("\nRecords are accessed sequentially.\n");

    return 0;
}
