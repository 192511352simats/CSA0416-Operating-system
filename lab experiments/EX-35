
#include <stdio.h>

int main()
{
    int index[50], n, i;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter the allocated block numbers:\n");

    for(i = 0; i < n; i++)
    {
        printf("Block %d: ", i + 1);
        scanf("%d", &index[i]);
    }

    printf("\nIndexed File Allocation\n");
    printf("Index Block contains:\n");

    for(i = 0; i < n; i++)
    {
        printf("Entry %d -> Block %d\n",
               i, index[i]);
    }

    printf("\nFile blocks are accessed using the index block.\n");

    return 0;
}
