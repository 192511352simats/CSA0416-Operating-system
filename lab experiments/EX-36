
#include <stdio.h>

int main()
{
    int block[50], n, i;
    int first, last;

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("Enter allocated disk block numbers:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &block[i]);
    }

    first = block[0];
    last = block[n - 1];

    printf("\nLinked File Allocation:\n");
    printf("First Block: %d\n", first);
    printf("Last Block: %d\n", last);

    printf("\nBlock\tNext Block\n");

    for(i = 0; i < n - 1; i++)
    {
        printf("%d\t%d\n", block[i], block[i + 1]);
    }

    printf("%d\tNULL\n", last);

    printf("\nFile block sequence:\n");

    for(i = 0; i < n; i++)
    {
        printf("%d", block[i]);

        if(i < n - 1)
            printf(" -> ");
    }

    printf(" -> NULL\n");

    return 0;
}
