#include <stdio.h>
int main()
{
    int n, i, time = 0, done = 0;
    int bt[20], rem[20], pr[20], wt[20], tat[20];
    printf("Enter number of processes: ");
    scanf("%d", &n);
    for(i = 0; i < n; i++)
    {
        printf("Enter burst time and priority for P%d: ", i + 1);
        scanf("%d%d", &bt[i], &pr[i]);
        rem[i] = bt[i];
    }
    while(done < n)
    {
        int best = -1;
        for(i = 0; i < n; i++)
        {
            if(rem[i] > 0 &&
               (best == -1 || pr[i] < pr[best]))
                best = i;
        }
        rem[best]--;
        time++;
        if(rem[best] == 0)
        {
            done++;
            tat[best] = time;
            wt[best] = tat[best] - bt[best];
        }
    }
    printf("\nProcess\tBT\tPriority\tWT\tTAT\n");
    float avgwt = 0, avgtat = 0;
    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t\t%d\t%d\n",
               i + 1, bt[i], pr[i], wt[i], tat[i]);

        avgwt += wt[i];
        avgtat += tat[i];
    }
    printf("Average WT = %.2f\n", avgwt / n);
    printf("Average TAT = %.2f\n", avgtat / n);
    return 0;
}
