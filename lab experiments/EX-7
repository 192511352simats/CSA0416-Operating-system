#include <stdio.h>
int main()
{
    int n, i, time = 0, done = 0;
    int at[20], bt[20], wt[20], tat[20], completed[20] = {0};
    printf("Enter number of processes: ");
    scanf("%d", &n);
    for(i = 0; i < n; i++)
    {
        printf("Enter arrival and burst time for P%d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
    }
    while(done < n)
    {
        int best = -1;
        for(i = 0; i < n; i++)
        {
            if(!completed[i] && at[i] <= time &&
               (best == -1 || bt[i] < bt[best]))
                best = i;
        }
        if(best == -1)
        {
            time++;
            continue;
        }
        wt[best] = time - at[best];
        time += bt[best];
        tat[best] = time - at[best];
        completed[best] = 1;
        done++;
    }

    printf("\nProcess\tAT\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++)
        printf("P%d\t%d\t%d\t%d\t%d\n",
               i + 1, at[i], bt[i], wt[i], tat[i]);

    return 0;
}
