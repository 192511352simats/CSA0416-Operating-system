#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>
#include <unistd.h>
int main()
{
    int shmid;
    char *shared;
    shmid = shmget(IPC_PRIVATE, 1024, IPC_CREAT | 0666);
    if(shmid == -1)
    {
        perror("shmget");
        return 1;
    }
    shared = (char *)shmat(shmid, NULL, 0);
    if(shared == (char *)-1)
    {
        perror("shmat");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }
    if(fork() == 0)
    {
        snprintf(shared, 1024, "Hello from child process!");
        shmdt(shared);
        exit(0);
    }
    else
    {
        wait(NULL);
        printf("Parent received: %s\n", shared);

        shmdt(shared);
        shmctl(shmid, IPC_RMID, NULL);
    }
    return 0;
}
